# Senha do admin (hash scrypt gerado com "npm run hash-password -- \"sua-senha\"")
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$SALT$HASH

# Upstash Redis (console.upstash.com > Redis > REST API)
UPSTASH_REDIS_REST_URL=https://seu-banco.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token

# Opcionais
SESSION_MAX_HOURS=12
LOGIN_MAX_ATTEMPTS=10
